@model Movie

@{
    ViewData["Title"] = Model.Title;
}

<div class="movie-details-container">

    <div class="row g-4 align-items-stretch">

        <!-- Poster Card -->
        <div class="col-lg-4 col-md-5">

            <div class="details-poster-card">

                <div class="details-poster">
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Poster)"
                         alt="@Model.Title" />
                </div>

                <div class="poster-caption">
                    <i class="bi bi-camera-reels-fill"></i>
                    <span>CinemaTV Movie Collection</span>
                </div>

            </div>

        </div>

        <!-- Movie Information -->
        <div class="col-lg-8 col-md-7">

            <div class="details-info-card">

                <!-- Title & Rating -->
                <div class="details-header">

                    <div class="details-title">
                        <span class="details-subtitle">
                            <i class="bi bi-film"></i>
                            MOVIE DETAILS
                        </span>

                        <h1>@Model.Title</h1>
                    </div>

                    <div class="details-rating">
                        <i class="bi bi-star-fill"></i>
                        <div>
                            <strong>@Model.Rate.ToString("0.0")</strong>
                            <small>/ 10</small>
                        </div>
                    </div>

                </div>

                <!-- Movie Metadata -->
                <div class="details-meta">

                    <div class="meta-item">
                        <span class="meta-icon">
                            <i class="bi bi-calendar3"></i>
                        </span>
                        <div>
                            <small>Release Year</small>
                            <strong>@Model.Year</strong>
                        </div>
                    </div>

                    <div class="meta-item">
                        <span class="meta-icon">
                            <i class="bi bi-tags-fill"></i>
                        </span>
                        <div>
                            <small>Genre</small>
                            <strong>@Model.Genre.Name</strong>
                        </div>
                    </div>

                </div>

                <div class="details-divider"></div>

                <!-- Storyline -->
                <div class="details-story">

                    <h4>
                        <i class="bi bi-book-half"></i>
                        Storyline
                    </h4>

                    <p>@Model.StoryLine</p>

                </div>

                <!-- Back Button -->
                <div class="details-actions">

                    <a asp-action="Index" class="back-to-movies">
                        <i class="bi bi-arrow-left"></i>
                        Back To Movies
                    </a>

                    <span class="details-brand">
                        <i class="bi bi-camera-reels-fill"></i>
                        CinemaTV
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>
